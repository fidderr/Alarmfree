import { Motion, Pal, Tr, Insets, Zoom } from "theme.slint";
import { Icon, IconName, AppSwitch, RoundIconButton, SlimChip, TabularText } from "components.slint";
import { BottomNav } from "nav.slint";

export struct DayCell { letter: string, on: bool }

export struct AlarmRow {
    id: string,
    time: string,
    twelve: bool,
    label: string,
    when: string,
    days: [DayCell],
    on: bool,
    can-skip: bool,
    skip-active: bool,
}

component AlarmCard inherits Rectangle {
    in property <AlarmRow> data;
    in property <bool> opened;
    in property <bool> can-reorder;
    in property <bool> lifted;
    // A line above it, from where the text starts, except on the first card.
    in property <bool> divider;
    callback open();
    callback menu();
    callback toggle();
    callback skip();
    callback delete();
    callback snap(bool);
    callback reorder-begin(length);
    callback reorder-move(length);
    callback reorder-end();
    // 0 waiting, 1 swiping sideways, 2 being dragged to a new place, 3 settled or scrolling.
    property <int> mode: 0;
    property <length> swipe: 0px;
    property <length> ref-y: 0px;
    property <length> action-w: (data.can-skip ? 2 : 1) * 64px;
    property <length> face-x: clamp((opened ? -action-w : 0px) + swipe, -action-w, 0px);
    height: 76px;
    clip: !lifted;
    accessible-role: list-item;
    accessible-label: data.time + " " + data.label + " " + data.when;
    accessible-action-default => { root.open(); }

    Rectangle {
        x: parent.width - root.action-w;
        width: root.action-w;
        visible: root.face-x < -0.5px;
        HorizontalLayout {
            if data.can-skip: Rectangle {
                background: Pal.surface2;
                accessible-role: button;
                accessible-label: Tr.t("action.skip_next");
                accessible-action-default => { root.skip(); }
                Icon { name: IconName.skip; size: 20px; tint: Pal.text; }
                TouchArea { clicked => { root.skip(); } }
            }
            Rectangle {
                background: Pal.danger;
                accessible-role: button;
                accessible-label: Tr.t("action.delete");
                accessible-action-default => { root.delete(); }
                Icon { name: IconName.trash; size: 20px; tint: Pal.bg; }
                TouchArea { clicked => { root.delete(); } }
            }
        }
    }
    face := Rectangle {
        x: root.face-x;
        width: parent.width;
        height: parent.height;
        background: root.lifted ? Pal.surface2 : Pal.surface;
        border-radius: root.lifted ? 14px : 0px;
        animate x { duration: root.mode == 1 ? 0ms : Motion.ms(180ms); easing: ease-out; }
        // The shadow of a lifted card only exists while it is lifted: a shadow on every card
        // makes each one an offscreen layer that is redrawn while the list scrolls.
        if root.lifted: Rectangle {
            width: parent.width;
            height: parent.height;
            z: -1;
            border-radius: 14px;
            background: Pal.surface2;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000066;
        }
        HorizontalLayout {
            padding-right: 6px;
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;
                    TabularText {
                        min-width: data.twelve ? 104px : 76px;
                        horizontal-stretch: 0;
                        text: data.time;
                        font-size: (data.twelve ? 20px : 24px) * Zoom.scale;
                        font-weight: 450;
                        letter-spacing: data.twelve ? 0px : -0.3px;
                        ink: data.on ? Pal.text : Pal.text2;
                        horizontal-alignment: left;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        horizontal-stretch: 1;
                        if data.label != "": Text {
                            text: data.label;
                            font-size: 14px * Zoom.scale;
                            font-weight: 500;
                            overflow: elide;
                            color: data.on ? Pal.text : Pal.text2;
                        }
                        if data.when != "": Text {
                            text: data.when;
                            font-size: 12px * Zoom.scale;
                            color: Pal.text2;
                            overflow: elide;
                        }
                        if data.when == "": HorizontalLayout {
                            spacing: 2px;
                            alignment: start;
                            for day in data.days: Text {
                                width: 13.2px;
                                horizontal-alignment: center;
                                text: day.letter;
                                font-size: 11px * Zoom.scale;
                                font-weight: (day.on && data.on) ? 700 : 400;
                                color: (day.on && data.on) ? Pal.accent : Pal.text2;
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: 32px;
                accessible-role: button;
                accessible-label: Tr.t("home.menu_aria");
                accessible-action-default => { root.menu(); }
                Icon { name: IconName.ellipsis-vertical; size: 18px; tint: Pal.text2; }
            }
            Rectangle {
                width: 52px;
                AppSwitch {
                    on: data.on;
                    label: Tr.t("home.switch_aria") + " " + data.label;
                    toggled => { root.toggle(); }
                }
            }
        }
    }
    if root.divider && !root.lifted: Rectangle {
        x: 16px;
        y: 0px;
        width: parent.width - 16px;
        height: 1px;
        background: Pal.line;
    }
    // Held for a moment: the card can be dragged to another place.
    hold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.mode == 0) {
                root.mode = 2;
                root.ref-y = ta.mouse-y;
                root.reorder-begin(ta.mouse-y);
            }
        }
    }
    ta := TouchArea {
        x: 0px;
        width: root.opened ? root.width - root.action-w : root.width;
        height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.mode = 0;
                root.swipe = 0px;
                hold.running = root.can-reorder && (ta.mouse-x - face.x) < face.width - 6px - 84px;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold.running = false;
                if (root.mode == 0 && e.kind == PointerEventKind.up && abs(ta.mouse-x - ta.pressed-x) > 10px && abs(ta.mouse-x - ta.pressed-x) > abs(ta.mouse-y - ta.pressed-y)) {
                    // A quick swipe that ended before a move was seen.
                    root.mode = 3;
                    root.snap((root.opened ? -root.action-w : 0px) + (ta.mouse-x - ta.pressed-x) < -root.action-w / 2);
                } else if (root.mode == 0 && e.kind == PointerEventKind.up) {
                    root.mode = 3;
                    if (ta.mouse-x - face.x > face.width - 6px - 52px) {
                        root.toggle();
                    } else if (ta.mouse-x - face.x > face.width - 6px - 84px) {
                        root.menu();
                    } else {
                        root.open();
                    }
                } else if (root.mode == 1) {
                    root.mode = 3;
                    root.snap(root.face-x < -root.action-w / 2);
                    root.swipe = 0px;
                } else if (root.mode == 2) {
                    root.mode = 3;
                    root.reorder-end();
                }
            }
        }
        moved => {
            if (root.mode == 0) {
                if (abs(ta.mouse-x - ta.pressed-x) > 10px && abs(ta.mouse-x - ta.pressed-x) > abs(ta.mouse-y - ta.pressed-y)) {
                    root.mode = 1;
                    hold.running = false;
                } else if (abs(ta.mouse-y - ta.pressed-y) > 10px) {
                    root.mode = 3;
                    hold.running = false;
                }
            }
            if (root.mode == 1) {
                root.swipe = ta.mouse-x - ta.pressed-x;
            } else if (root.mode == 2) {
                root.reorder-move(ta.mouse-y - root.ref-y);
            }
        }
    }
}

export component HomeScreen inherits Rectangle {
    in property <string> next-title;
    in property <string> next-sub;
    in property <[AlarmRow]> rows;
    in property <bool> paused;
    in property <[string]> quick-labels;
    in property <string> banner;
    in property <bool> banner-can-hide;
    in property <string> empty-weekdays;
    in property <string> empty-weekend;
    in property <bool> can-reorder;
    // The card swiped open, and the card being dragged.
    property <string> open-id;
    property <int> drag-from: -1;
    property <length> drag-dy: 0px;
    property <length> press-y: 0px;
    property <int> drag-to: drag-from < 0 ? -1 : clamp(drag-from + Math.round(drag-dy / 76px), 0, root.rows.length - 1);
    callback skip(string);
    callback delete(string);
    callback reorder(int, int);
    callback reorder-started();
    callback open(string);
    callback menu(string);
    callback toggle(string);
    callback quick(int);
    callback create();
    callback pause-all();
    callback sort();
    callback go(int);
    callback open-banner();
    callback hide-banner();
    callback template(int);
    background: Pal.bg;

    VerticalLayout {
        padding-top: Insets.top;
        padding-left: Insets.left;
        padding-right: Insets.right;
        HorizontalLayout {
            padding: 20px;
            padding-top: 28px;
            padding-bottom: 16px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                Text { text: Tr.t("home.next_label"); font-size: 12px * Zoom.scale; font-weight: 500; color: Pal.text2; }
                Text { text: root.next-title; font-size: 28px * Zoom.scale; font-weight: 700; line-height-factor: 1.036; color: Pal.text; overflow: elide; }
                if root.next-sub != "": VerticalLayout {
                    padding-top: 4px;
                    Text { text: root.next-sub; font-size: 14px * Zoom.scale; color: Pal.text2; }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 8px;
                alignment: start;
                RoundIconButton { icon: IconName.pause; label: Tr.t("home.pause_aria"); active: root.paused; clicked => { root.pause-all(); } }
                RoundIconButton { icon: IconName.sort; label: Tr.t("home.sort_aria"); clicked => { root.sort(); } }
            }
        }
        if root.banner != "": Rectangle {
            height: banner-box.height + 16px;
            banner-box := Rectangle {
                x: 16px;
                y: 0px;
                width: parent.width - 32px;
                height: max(44px, banner-text.preferred-height + 20px);
                border-radius: 14px;
                background: Pal.warn-soft;
                TouchArea { clicked => { root.open-banner(); } }
                if root.banner-can-hide: Rectangle {
                    x: parent.width - 44px;
                    width: 44px;
                    accessible-role: button;
                    accessible-label: Tr.t("reliability.hide");
                    accessible-action-default => { root.hide-banner(); }
                    Icon { name: IconName.xmark; size: 16px; tint: Pal.text2; }
                    TouchArea { clicked => { root.hide-banner(); } }
                }
                Icon { name: IconName.warning; size: 18px; tint: Pal.warn; x: 12px; y: (parent.height - self.height) / 2; }
                banner-fix := Text {
                    x: parent.width - (root.banner-can-hide ? 56px : 12px) - self.width;
                    y: (parent.height - self.height) / 2;
                    text: Tr.t("reliability.fix");
                    font-size: 14px * Zoom.scale;
                    font-weight: 500;
                    color: Pal.warn;
                }
                banner-text := Text {
                    x: 40px;
                    y: (parent.height - self.height) / 2;
                    width: banner-fix.x - 10px - 40px;
                    text: root.banner;
                    font-size: 14px * Zoom.scale;
                    color: Pal.text;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 4px;
            spacing: 8px;
            Text { text: Tr.t("home.quick"); font-size: 12px * Zoom.scale; font-weight: 500; color: Pal.text2; vertical-alignment: center; }
            for label[i] in root.quick-labels: SlimChip {
                horizontal-stretch: 1;
                text: label;
                clicked => { root.quick(i); }
            }
        }
        fl := Flickable {
            vertical-stretch: 1;
            interactive: root.drag-from < 0;
            content-height: max(self.height, 12px + root.rows.length * 76px + 88px);
            Rectangle {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: root.rows.length * 76px;
                border-radius: 20px;
                clip: root.drag-from < 0;
                background: Pal.surface;
                visible: root.rows.length > 0;
                for row[i] in root.rows: AlarmCard {
                    y: i == root.drag-from ? i * 76px + root.drag-dy
                        : i * 76px + ((root.drag-from >= 0 && root.drag-from < root.drag-to && i > root.drag-from && i <= root.drag-to) ? -76px
                        : ((root.drag-from >= 0 && root.drag-from > root.drag-to && i >= root.drag-to && i < root.drag-from) ? 76px : 0px));
                    z: i == root.drag-from ? 10 : 0;
                    animate y { duration: i == root.drag-from ? 0ms : Motion.ms(150ms); easing: ease-out; }
                    data: row;
                    opened: root.open-id == row.id;
                    can-reorder: root.can-reorder;
                    lifted: i == root.drag-from;
                    divider: i > 0 && i != root.drag-from && i != root.drag-from + 1;
                    open => { root.open(row.id); }
                    menu => { root.menu(row.id); }
                    toggle => { root.toggle(row.id); }
                    skip => { root.open-id = ""; root.skip(row.id); }
                    delete => { root.open-id = ""; root.delete(row.id); }
                    snap(open) => { root.open-id = open ? row.id : ""; }
                    reorder-begin(y) => {
                        root.open-id = "";
                        root.press-y = y;
                        root.drag-dy = 0px;
                        root.drag-from = i;
                        root.reorder-started();
                    }
                    reorder-move(delta) => {
                        root.drag-dy = clamp(root.drag-dy + delta, -i * 76px, (root.rows.length - 1 - i) * 76px);
                    }
                    reorder-end() => {
                        root.reorder(root.drag-from, root.drag-to);
                        root.drag-from = -1;
                        root.drag-dy = 0px;
                    }
                }
            }
            if root.rows.length == 0: VerticalLayout {
                padding: 32px;
                padding-top: 48px;
                spacing: 8px;
                alignment: start;
                Rectangle {
                    height: 40px;
                    Icon { name: IconName.clock; size: 40px; tint: Pal.text2; }
                }
                Text { text: Tr.t("alarm.no_alarms"); font-size: 16px * Zoom.scale; font-weight: 500; horizontal-alignment: center; color: Pal.text; }
                Text { text: Tr.t("alarm.tap_to_create"); font-size: 14px * Zoom.scale; horizontal-alignment: center; wrap: word-wrap; color: Pal.text2; }
                Rectangle { height: 0px; }
                for label[i] in [root.empty-weekdays, root.empty-weekend]: Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: Pal.surface;
                    Text { text: label; font-size: 14px * Zoom.scale; font-weight: 500; color: Pal.text; }
                    TouchArea { clicked => { root.template(i); } }
                }
            }
        }
        Timer {
            interval: 16ms;
            running: root.drag-from >= 0;
            triggered => {
                // Near the top or bottom edge of the list it scrolls under the finger.
                let finger = 12px + root.drag-from * 76px + root.press-y + root.drag-dy + fl.content-y;
                let room = fl.content-height - fl.height + fl.content-y;
                if (finger < 70px && fl.content-y < 0px) {
                    let step = min(14px, -fl.content-y);
                    fl.content-y += step;
                    root.drag-dy -= step;
                } else if (finger > fl.height - 70px && room > 0px) {
                    let step = min(14px, room);
                    fl.content-y -= step;
                    root.drag-dy += step;
                }
            }
        }
        BottomNav {
            current: 0;
            go(i) => { root.go(i); }
        }
    }

    Rectangle {
        x: parent.width - 56px - 16px - Insets.right;
        y: parent.height - 64px - Insets.bottom - 16px - 56px;
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: Pal.accent;
        accessible-role: button;
        accessible-label: Tr.t("home.create_aria");
        accessible-action-default => { root.create(); }
        Icon { name: IconName.plus; size: 24px; tint: Pal.on-accent; }
        TouchArea { clicked => { root.create(); } }
    }
}
