import { Pal, Tr, Insets } from "theme.slint";
import { Icon, IconName, TabularText } from "components.slint";
import { ScreenHeader, Row, SwitchRow, RowList, Separator, PrimaryButton, ChoiceChips, Sheet } from "widgets.slint";
import { DayCell } from "home.slint";
import { Cfg, ChallengesSheet, AddChallengeSheet, ChallengeDetailSheet } from "challenge_sheets.slint";
import { Ed, TimeSheet, DateSheet, LabelSheet, SoundSheet, VibrationSheet, SnoozeSheet, OptionsSheet, RingLookSheet, RingColourSheet } from "editor_sheets.slint";

// The step of the time: a pill, 56 by 36 dp.
component TimeShift inherits Rectangle {
    in property <string> text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 36px;
    border-radius: 18px;
    background: Pal.surface;
    Text { text: root.text; font-size: 14px; font-weight: 500; color: Pal.text; }
    TouchArea { clicked => { root.clicked(); } }
}

// A plain choice in a sheet that cannot be undone: red text, 52 dp high.
component DangerItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 52px;
    Text { x: 0px; text: root.text; font-size: 16px; color: Pal.danger; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

// Which panel is open over the editor.
export enum EditorSheet { none, time, date, label, sound, vibration, snooze, delete, discard, challenges, add-challenge, detail, limit, wake-check, notice, ring-look, ring-colour }

// Making and changing an alarm: the time and the days are right there; everything else is one
// summary row that opens a sheet.
export component EditorScreen inherits Rectangle {
    in property <string> title;
    in property <bool> deletable;
    in property <string> time-text;
    in property <bool> twelve;
    // Editing what new alarms start from: no time, no days.
    in property <bool> defaults;
    in property <string> rings-text;
    in property <[DayCell]> days;
    in property <[string]> preset-labels;
    in property <int> preset-active: -1;
    in property <bool> one-time;
    in property <string> once-text;
    in property <string> error;
    in-out property <EditorSheet> sheet: EditorSheet.none;
    callback back();
    callback save();
    callback shift(int);
    callback day-toggled(int);
    callback preset(int);
    callback delete-confirmed();
    callback discard-confirmed();
    callback sheet-closed();
    callback sheet-opened(EditorSheet);
    background: Pal.bg;

    function open(s: EditorSheet) {
        root.sheet = s;
        root.sheet-opened(s);
    }
    public function close-sheet() {
        root.sheet = EditorSheet.none;
        root.sheet-closed();
    }

    VerticalLayout {
        padding-top: Insets.top;
        padding-left: Insets.left;
        padding-right: Insets.right;
        ScreenHeader {
            title: root.title;
            back => { root.back(); }
            if root.deletable: Rectangle {
                width: 44px;
                Icon { name: IconName.trash; size: 20px; tint: Pal.text2; }
                TouchArea { clicked => { root.open(EditorSheet.delete); } }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding-bottom: 16px;
                alignment: start;
                // The time, large, with a step either way, and when that rings.
                if !root.defaults: VerticalLayout {
                    padding-top: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    HorizontalLayout {
                        height: 80px;
                        VerticalLayout {
                            width: 56px;
                            spacing: 8px;
                            TimeShift { text: "\u{2212}1"; clicked => { root.shift(-1); } }
                            TimeShift { text: "\u{2212}5"; clicked => { root.shift(-5); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            TabularText {
                                width: parent.width;
                                height: parent.height;
                                text: root.time-text;
                                font-size: root.twelve ? 44px : 64px;
                                font-weight: 500;
                                letter-spacing: -1px;
                                ink: Pal.text;
                            }
                            TouchArea { clicked => { root.open(EditorSheet.time); } }
                        }
                        VerticalLayout {
                            width: 56px;
                            spacing: 8px;
                            TimeShift { text: "+1"; clicked => { root.shift(1); } }
                            TimeShift { text: "+5"; clicked => { root.shift(5); } }
                        }
                    }
                    VerticalLayout {
                        padding-top: 8px;
                        Text {
                            text: root.rings-text;
                            font-size: 14px;
                            color: Pal.text2;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                // Which days, or the one date.
                if !root.defaults: VerticalLayout {
                    padding-top: 20px;
                    padding-left: 16px;
                    padding-right: 16px;
                    if root.one-time: Rectangle {
                        height: 44px;
                        border-radius: 14px;
                        background: Pal.accent;
                        accessible-role: button;
                        accessible-label: root.once-text;
                        accessible-action-default => { root.open(EditorSheet.date); }
                        Text { text: root.once-text; font-size: 14px; font-weight: 500; color: Pal.on-accent; }
                        TouchArea { clicked => { root.open(EditorSheet.date); } }
                    }
                    if !root.one-time: Rectangle {
                        height: 44px;
                        // 44 dp places to tap, 38 dp round buttons in them: the first and the last line up with the rest.
                        HorizontalLayout {
                            x: -3px;
                            width: parent.width + 6px;
                            alignment: space-between;
                            for day[i] in root.days: Rectangle {
                                width: 44px;
                                accessible-role: button;
                                accessible-label: day.letter;
                                accessible-checkable: true;
                                accessible-checked: day.on;
                                accessible-action-default => { root.day-toggled(i); }
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 19px;
                                    background: day.on ? Pal.accent : Pal.surface;
                                    Text {
                                        text: day.letter;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: day.on ? Pal.on-accent : Pal.text2;
                                    }
                                }
                                TouchArea { clicked => { root.day-toggled(i); } }
                            }
                        }
                    }
                    VerticalLayout {
                        padding-top: 16px;
                        ChoiceChips {
                            small: true;
                            labels: root.preset-labels;
                            selected: root.preset-active;
                            picked(i) => { root.preset(i); }
                        }
                    }
                    if root.error != "": VerticalLayout {
                        padding-top: 8px;
                        Text {
                            text: root.error;
                            font-size: 12px;
                            color: Pal.danger;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: root.defaults ? 16px : 20px;
                    RowList {
                        Row { title: Tr.t("config.label"); value: Ed.label-summary; clicked => { root.open(EditorSheet.label); } }
                        Separator { }
                        Row { title: Tr.t("config.sound"); value: Ed.sound-summary; clicked => { root.open(EditorSheet.sound); } }
                        Separator { }
                        Row { title: Tr.t("config.vibration"); value: Ed.vibration-summary; clicked => { root.open(EditorSheet.vibration); } }
                        Separator { }
                        Row { title: Tr.t("config.snooze"); value: Ed.snooze-summary; clicked => { root.open(EditorSheet.snooze); } }
                        Separator { }
                        Row { title: Tr.t("config.challenges"); value: Cfg.summary; clicked => { root.open(EditorSheet.challenges); } }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 16px;
                    RowList {
                        Row { title: Tr.t("config.ring_look"); value: Ed.look-summary; clicked => { root.open(EditorSheet.ring-look); } }
                        Separator { }
                        Row { title: Tr.t("config.ring_limit"); value: Ed.limit-summary; clicked => { root.open(EditorSheet.limit); } }
                        Separator { }
                        Row { title: Tr.t("config.wake_check"); value: Ed.check-summary; clicked => { root.open(EditorSheet.wake-check); } }
                        Separator { }
                        Row { title: Tr.t("config.notice"); value: Ed.notice-summary; clicked => { root.open(EditorSheet.notice); } }
                        Separator { }
                        SwitchRow { title: Tr.t("config.max_brightness"); on: Ed.bright; toggled(on) => { Ed.bright-toggled(on); } }
                    }
                }
            }
        }
        Rectangle {
            height: 12px + 52px + 16px + Insets.bottom;
            background: Pal.bg;
            VerticalLayout {
                padding-top: 12px;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px + Insets.bottom;
                PrimaryButton { text: Tr.t("action.save"); clicked => { root.save(); } }
            }
        }
    }

    if root.sheet == EditorSheet.time: TimeSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.date: DateSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.label: LabelSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.sound: SoundSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.vibration: VibrationSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.snooze: SnoozeSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.limit: OptionsSheet {
        title: Tr.t("config.ring_limit");
        help: Tr.t("config.limit_note");
        done => { root.close-sheet(); }
    }
    if root.sheet == EditorSheet.wake-check: OptionsSheet {
        title: Tr.t("config.wake_check");
        help: Tr.t("config.wake_check_note");
        done => { root.close-sheet(); }
    }
    if root.sheet == EditorSheet.notice: OptionsSheet {
        title: Tr.t("config.notice");
        help: Tr.t("config.notice_note");
        done => { root.close-sheet(); }
    }
    if root.sheet == EditorSheet.ring-look: RingLookSheet { done => { root.close-sheet(); } }
    if root.sheet == EditorSheet.ring-colour: RingColourSheet { back => { root.open(EditorSheet.ring-look); } }
    if root.sheet == EditorSheet.delete: Sheet {
        title: Tr.t("alarm.delete_confirm");
        done-text: Tr.t("alarm.keep");
        finish => { root.close-sheet(); }
        close => { root.close-sheet(); }
        DangerItem { text: Tr.t("action.delete"); clicked => { root.delete-confirmed(); } }
    }
    if root.sheet == EditorSheet.discard: Sheet {
        title: Tr.t("config.discard_title");
        done-text: Tr.t("config.keep_editing");
        finish => { root.close-sheet(); }
        close => { root.close-sheet(); }
        DangerItem { text: Tr.t("config.discard"); clicked => { root.discard-confirmed(); } }
    }
    if root.sheet == EditorSheet.challenges: ChallengesSheet {
        done => { root.sheet = EditorSheet.none; }
        add-open => { root.sheet = EditorSheet.add-challenge; }
    }
    if root.sheet == EditorSheet.add-challenge: AddChallengeSheet {
        back => { root.sheet = EditorSheet.challenges; }
    }
    if root.sheet == EditorSheet.detail: ChallengeDetailSheet {
        back => { root.sheet = EditorSheet.challenges; }
    }
}
