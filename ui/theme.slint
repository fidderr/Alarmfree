// The colours of the active theme. Rust fills them from `Palette::css_vars`, so the
// themes, accents and the colour editor work as they did.
export global Pal {
    in property <color> bg: #101218;
    in property <color> surface: #1b1d24;
    in property <color> surface2: #262930;
    in property <color> line: #2a2d35;
    in property <color> text: #eef0f5;
    in property <color> text2: #a4a8b3;
    in property <color> accent: #7cb0ff;
    in property <color> on-accent: #0b1a33;
    in property <color> accent-soft: #1f2d45;
    in property <color> accent-glow: #7cb0ff73;
    in property <color> warn: #ffb454;
    in property <color> warn-soft: #3a2f22;
    in property <color> danger: #ff8a7a;
    in property <color> ok: #6fd6a0;
    in property <color> ok-glow: #6fd6a08c;
    in property <color> off: #3a3d45;
    in property <color> knob-off: #a4a8b3;
    in property <color> inverse: #eef0f5;
    in property <color> on-inverse: #1b1d24;
    in property <color> bar-soft: #3d5070;
    in property <bool> light: false;
}

// Text for the active language. `rev` changes with the language, which makes every `Tr.t(..)`
// in a binding read again.
export global Tr {
    in property <int> rev: 0;
    pure callback lookup(string, int) -> string;
    public pure function t(key: string) -> string {
        return lookup(key, rev);
    }
}

// How far the system bars overlap the window, and the soft keyboard.
export global Insets {
    in-out property <length> top: 0px;
    in-out property <length> bottom: 0px;
    in-out property <length> left: 0px;
    in-out property <length> right: 0px;
}

// "Less motion" in the settings: every decorative animation takes no time.
export global Motion {
    in property <bool> less: false;
    public pure function ms(normal: duration) -> duration {
        return less ? 0ms : normal;
    }
}

// The phone's font size setting, as a factor. Texts multiply their size by it; the big clocks do not,
// like the original, which divided them by the same factor.
export global Zoom {
    in property <float> scale: 1;
}
