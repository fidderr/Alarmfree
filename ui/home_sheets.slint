import { Pal, Tr, Zoom } from "theme.slint";
import { Icon, IconName } from "components.slint";
import { Sheet } from "widgets.slint";
import { DatePicker } from "datepicker.slint";

export struct SheetChoice { text: string, selected: bool, danger: bool }

// Which panel is open over the list.
export enum HomeSheet { none, sort, pause-all, pause-date, menu }

component SheetItem inherits Rectangle {
    in property <SheetChoice> choice;
    callback clicked();
    accessible-role: button;
    accessible-label: root.choice.text;
    accessible-action-default => { root.clicked(); }
    height: 52px;
    HorizontalLayout {
        Text {
            horizontal-stretch: 1;
            text: root.choice.text;
            font-size: 16px * Zoom.scale;
            font-weight: root.choice.selected ? 500 : 400;
            color: root.choice.danger ? Pal.danger : root.choice.selected ? Pal.accent : Pal.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.choice.selected: Icon { name: IconName.check; size: 20px; tint: Pal.accent; y: (parent.height - self.height) / 2; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// The panels over the alarm list: the order, pausing, and what else can be done to one alarm.
export component HomeSheets inherits Rectangle {
    in property <HomeSheet> sheet;
    in property <string> title;
    in property <[SheetChoice]> choices;
    callback close();
    callback picked(int);
    callback pause-apply();
    if root.sheet == HomeSheet.sort || root.sheet == HomeSheet.pause-all || root.sheet == HomeSheet.menu: Sheet {
        title: root.title;
        help: root.sheet == HomeSheet.sort ? Tr.t("home.sort_note") : root.sheet == HomeSheet.pause-all ? Tr.t("home.pause_note") : "";
        close => { root.close(); }
        VerticalLayout {
            for choice[i] in root.choices: SheetItem {
                choice: choice;
                clicked => { root.picked(i); }
            }
        }
    }
    if root.sheet == HomeSheet.pause-date: Sheet {
        title: Tr.t("home.pause_date");
        help: Tr.t("home.pause_date_note");
        done-text: Tr.t("home.pause_apply");
        finish => { root.pause-apply(); }
        close => { root.close(); }
        DatePicker { }
    }
}
