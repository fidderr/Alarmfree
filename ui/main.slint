import { Pal, Tr, Insets, Motion } from "theme.slint";
import { HomeScreen, AlarmRow, DayCell } from "home.slint";
import { Toast } from "components.slint";
import { EditorScreen, EditorSheet } from "editor.slint";
import { Ed, SoundRow, LookTile, SwatchCell, UsedChip } from "editor_sheets.slint";
import { Cal, DateCell } from "datepicker.slint";
import { Hue } from "colour.slint";
import { Look } from "backdrop.slint";
import { Rel, CheckRow, ReliabilityScreen } from "reliability.slint";
import { RingScreen } from "ring.slint";
import { HomeSheets, HomeSheet, SheetChoice } from "home_sheets.slint";
import { Run, RunScreen, RunCell, TypeCell, ReactTarget, RunKind } from "challenges.slint";
import { Cfg, CfgRow, CfgType, CfgStepper } from "challenge_sheets.slint";
import { SettingsScreen, SettingsView } from "settings.slint";
import { HistoryScreen, StatLine, BarCell, EventLine } from "history.slint";
import { PanelSheet } from "panel.slint";
import { Thm, ThemeScreen, ThemeTile } from "theme_screen.slint";
export { Pal, Tr, Insets, AlarmRow, DayCell, EditorSheet, HomeSheet, SheetChoice }
export { Ed, SoundRow, LookTile, SwatchCell, UsedChip, Cal, DateCell, Hue, Look, Rel, CheckRow }
export { SettingsView, StatLine, BarCell, EventLine, Motion, Thm, ThemeTile }
export { Run, RunCell, TypeCell, ReactTarget, RunKind, Cfg, CfgRow, CfgType, CfgStepper }

export component MainWindow inherits Window {
    in property <string> next-title;
    in property <string> next-sub;
    in property <[AlarmRow]> rows;
    in property <bool> paused;
    in property <[string]> quick-labels;
    in property <string> banner;
    in property <bool> banner-can-hide;
    in property <string> empty-weekdays;
    in property <string> empty-weekend;
    // 0 alarms, 1 editor, 2 history, 3 settings.
    in-out property <int> screen: 0;
    in property <bool> ringing;
    // The panels over the list.
    in-out property <HomeSheet> home-sheet: HomeSheet.none;
    in property <string> hs-title;
    in property <[SheetChoice]> hs-choices;
    callback hs-close();
    callback hs-picked(int);
    callback hs-pause-apply();
    // The settings.
    in property <SettingsView> st;
    callback st-row(int);
    callback st-toggled(int, bool);
    // The history.
    in property <[string]> h-periods;
    in property <int> h-period;
    in-out property <string> h-custom-text;
    in property <int> h-empty;
    in property <string> h-streak;
    in property <string> h-time-to-stop;
    in property <string> h-snoozes;
    in property <[BarCell]> h-bars;
    in property <bool> h-has-bars;
    in property <[StatLine]> h-stats;
    in property <[EventLine]> h-events;
    callback h-delete-history();
    callback h-period-picked(int);
    callback h-custom-edited(string);
    callback h-custom-accepted();
    callback h-delete-event(string);
    // The panel over the history and the settings.
    in-out property <bool> panel-open: false;
    in property <string> pn-title;
    in property <string> pn-help;
    in property <string> pn-note;
    in property <string> pn-line;
    in property <string> pn-done;
    in property <[SheetChoice]> pn-choices;
    in property <[string]> pn-chips;
    in property <int> pn-chip-selected;
    callback pn-close();
    callback pn-picked(int);
    callback pn-chip-picked(int);
    callback pn-done-tapped();
    // The editor.
    in property <string> ed-title;
    in property <bool> ed-defaults;
    in property <bool> ed-deletable;
    in property <string> ed-time-text;
    in property <bool> ed-twelve;
    in property <string> ed-rings-text;
    in property <[DayCell]> ed-days;
    in property <[string]> ed-preset-labels;
    in property <int> ed-preset-active;
    in property <bool> ed-one-time;
    in property <string> ed-once-text;
    in property <string> ed-error;
    in-out property <EditorSheet> ed-sheet: EditorSheet.none;
    callback ed-back();
    callback ed-save();
    callback ed-shift(int);
    callback ed-day-toggled(int);
    callback ed-preset(int);
    callback ed-delete-confirmed();
    callback ed-discard-confirmed();
    callback ed-sheet-closed();
    callback ed-sheet-opened(EditorSheet);
    // The ring screen from the editor, as the alarm being edited would show it.
    in-out property <bool> ed-preview: false;
    // The ring screen.
    in property <string> ring-date;
    in property <string> ring-clock;
    in property <string> ring-label;
    in property <string> ring-note;
    in property <string> ring-snooze-text;
    in property <bool> ring-can-snooze;
    in property <string> ring-challenges-text;
    in property <int> ring-challenge-count;
    callback ring-snooze();
    callback ring-turn-off();
    callback open(string);
    callback menu(string);
    callback toggle(string);
    callback quick(int);
    callback create();
    callback pause-all();
    callback sort();
    callback go(int);
    callback open-banner();
    callback hide-banner();
    callback template(int);
    callback back();
    in property <bool> toast-visible;
    in property <string> toast-text;
    in property <bool> toast-error;
    in property <bool> toast-has-undo;
    callback toast-undo();
    callback toast-dismiss();
    background: Pal.bg;
    default-font-size: 14px;

    // The window's bars and the soft keyboard, for every screen.
    function update-insets() {
        Insets.top = root.safe-area-insets.top;
        Insets.left = root.safe-area-insets.left;
        Insets.right = root.safe-area-insets.right;
        Insets.bottom = max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
    }
    init => { update-insets(); }
    changed safe-area-insets => { update-insets(); }
    changed virtual-keyboard-size => { update-insets(); }

    if root.screen == 0: HomeScreen {
        next-title: root.next-title;
        next-sub: root.next-sub;
        rows: root.rows;
        paused: root.paused;
        quick-labels: root.quick-labels;
        banner: root.banner;
        banner-can-hide: root.banner-can-hide;
        empty-weekdays: root.empty-weekdays;
        empty-weekend: root.empty-weekend;
        open(id) => { root.open(id); }
        menu(id) => { root.menu(id); }
        toggle(id) => { root.toggle(id); }
        quick(i) => { root.quick(i); }
        create => { root.create(); }
        pause-all => { root.pause-all(); }
        sort => { root.sort(); }
        go(i) => { root.go(i); }
        open-banner => { root.open-banner(); }
        hide-banner => { root.hide-banner(); }
        template(i) => { root.template(i); }
    }

    if root.screen == 0: HomeSheets {
        sheet: root.home-sheet;
        title: root.hs-title;
        choices: root.hs-choices;
        close => { root.home-sheet = HomeSheet.none; root.hs-close(); }
        picked(i) => { root.hs-picked(i); }
        pause-apply => { root.hs-pause-apply(); }
    }

    if root.screen == 2: HistoryScreen {
        periods: root.h-periods;
        period: root.h-period;
        custom-text <=> root.h-custom-text;
        empty: root.h-empty;
        streak: root.h-streak;
        time-to-stop: root.h-time-to-stop;
        snoozes: root.h-snoozes;
        bars: root.h-bars;
        has-bars: root.h-has-bars;
        stats: root.h-stats;
        events: root.h-events;
        go(i) => { root.go(i); }
        delete-history => { root.h-delete-history(); }
        period-picked(i) => { root.h-period-picked(i); }
        custom-edited(s) => { root.h-custom-edited(s); }
        custom-accepted => { root.h-custom-accepted(); }
        delete-event(id) => { root.h-delete-event(id); }
    }

    if root.screen == 3: SettingsScreen {
        st: root.st;
        go(i) => { root.go(i); }
        open-row(i) => { root.st-row(i); }
        toggled(i, on) => { root.st-toggled(i, on); }
    }

    if (root.screen == 2 || root.screen == 3) && root.panel-open: PanelSheet {
        title: root.pn-title;
        help: root.pn-help;
        note: root.pn-note;
        line: root.pn-line;
        done-text: root.pn-done;
        choices: root.pn-choices;
        chips: root.pn-chips;
        chip-selected: root.pn-chip-selected;
        close => { root.panel-open = false; root.pn-close(); }
        picked(i) => { root.pn-picked(i); }
        chip-picked(i) => { root.pn-chip-picked(i); }
        done => { root.pn-done-tapped(); }
    }

    if root.screen == 1: editor := EditorScreen {
        defaults: root.ed-defaults;
        title: root.ed-title;
        deletable: root.ed-deletable;
        time-text: root.ed-time-text;
        twelve: root.ed-twelve;
        rings-text: root.ed-rings-text;
        days: root.ed-days;
        preset-labels: root.ed-preset-labels;
        preset-active: root.ed-preset-active;
        one-time: root.ed-one-time;
        once-text: root.ed-once-text;
        error: root.ed-error;
        sheet <=> root.ed-sheet;
        back => { root.ed-back(); }
        save => { root.ed-save(); }
        shift(m) => { root.ed-shift(m); }
        day-toggled(i) => { root.ed-day-toggled(i); }
        preset(i) => { root.ed-preset(i); }
        delete-confirmed => { root.ed-delete-confirmed(); }
        discard-confirmed => { root.ed-discard-confirmed(); }
        sheet-closed => { root.ed-sheet-closed(); }
        sheet-opened(sheet) => { root.ed-sheet-opened(sheet); }
    }

    if root.ringing: RingScreen {
        date: root.ring-date;
        clock: root.ring-clock;
        label: root.ring-label;
        note: root.ring-note;
        snooze-text: root.ring-snooze-text;
        can-snooze: root.ring-can-snooze;
        challenges-text: root.ring-challenges-text;
        challenge-count: root.ring-challenge-count;
        snooze => { root.ring-snooze(); }
        turn-off => { root.ring-turn-off(); }
    }

    if root.screen == 4: ReliabilityScreen { }

    if root.screen == 5: ThemeScreen { }

    if root.ed-preview: RingScreen {
        preview: true;
        date: root.ring-date;
        clock: root.ring-clock;
        label: root.ring-label;
        note: root.ring-note;
        snooze-text: root.ring-snooze-text;
        can-snooze: root.ring-can-snooze;
        challenges-text: Tr.t("ring.preview_hint");
        challenge-count: 1;
        closed => { root.ed-preview = false; }
    }

    if Run.active: RunScreen { }

    if root.toast-visible: Toast {
        x: 16px + Insets.left;
        width: min(parent.width - 16px - Insets.left - (root.toast-error ? 16px : 88px) - Insets.right, 460px);
        // At the top while a panel has the bottom.
        y: (root.home-sheet != HomeSheet.none || root.panel-open || (root.screen == 1 && root.ed-sheet != EditorSheet.none)) ? Insets.top + 8px : parent.height - 64px - Insets.bottom - 16px - self.height;
        text: root.toast-text;
        error: root.toast-error;
        has-undo: root.toast-has-undo;
        undo => { root.toast-undo(); }
        dismiss => { root.toast-dismiss(); }
    }
}
